{
  "name": "@her-os/dsh-memory",
  "version": "0.0.1",
  "description": "Her 的长期记忆：自动记住聊天里的重要信息，下次对话时自然想起。由北京词元共振智能科技有限公司开发。",
  "license": "MIT",
  "author": "Her",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/her-os/her-dsh-memory.git",
    "directory": "packages/dsh"
  },
  "keywords": [
    "dsh-plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/typert.host.js",
    "lib/typert.remote-client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-loader": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@her-os/memory-core": "workspace:*",
    "@her-os/memory-local-embed": "workspace:*",
    "@tanstack/react-virtual": "3.13.12",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "homepage": "https://hersoul.cn/zh"
}
